# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ⚠️ ห้าม commit ไฟล์ .env เข้า git เด็ดขาด (มี .env อยู่ใน .gitignore แล้ว)
# ============================================================

# Database (SQL Server on-premise) — config/db.js อ่านค่าพวกนี้
# ขาดตัวใดตัวหนึ่ง server จะ exit ทันทีตอน boot
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT Secret — ใช้เซ็น/ตรวจ token ยืนยันตัวตน (middleware/auth.js)
# สร้างค่าใหม่แบบสุ่ม: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ต้องเป็นค่าที่ไม่เคยแชร์ที่ไหนมาก่อน — ถ้าหลุด ใครก็ปลอม token เป็น superadmin ได้
JWT_SECRET=

# Server port
PORT=3000

# จำนวนวันที่เก็บ ActivityLog ก่อนถูกลบอัตโนมัติ (jobs/logRetention.js)
# ไม่ตั้งค่า = 90 วัน
LOG_RETENTION_DAYS=90

# Active Directory / LDAP (services/ldap.js) — ใช้ตอน login ด้วยบัญชี Windows
AD_URL=ldap://your-ad-server.example.local
AD_DOMAIN=example.local

# Origin ที่อนุญาตให้เรียก API คั่นด้วย comma (middleware/security.js)
# ต้องตั้งเป็น origin จริงก่อน deploy — ค่า default fallback คือ localhost เท่านั้น
ALLOWED_ORIGINS=http://localhost:3000
